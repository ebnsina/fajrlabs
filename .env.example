# Required. The site fails loudly rather than silently dropping enquiries.
# In production, set these under Project > Settings > Environment Variables in Vercel.
# Create a key at https://resend.com/api-keys
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_TO_EMAIL=

# The verified sender, e.g. "FajrLabs <salam@fajrlabs.io>"
CONTACT_FROM_EMAIL=
